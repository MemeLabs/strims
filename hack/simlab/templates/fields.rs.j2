{% if families %}

/// The place of the name `name` formats among a family's `names`.
// A name the document doesn't give the sim is the sim's mistake, never
// a peer's input: it stops the run.
#[allow(clippy::panic)]
fn of(names: &[&'static str], name: Arguments) -> u16 {
    let name = name.to_string();
    match names.iter().position(|n| *n == name) {
        Some(i) => i as u16,
        None => panic!("{name}: crates/strims-wan/fields.toml gives {{ sim }} no such name"),
    }
}

/// The name at place `i` among a family's `names`.
fn at(names: &[&'static str], i: u16) -> &'static str {
    names.get(usize::from(i)).copied().unwrap_or_default()
}
