/// A JSON object written key by key: a run's row, or its
/// `series_meta.json`. Its keys are this module's names, each written as
/// its type, and once: a key written twice panics.
#[derive(Default)]
pub(crate) struct JsonRow {
    text: String,
    keys: BTreeSet<&'static str>,
}

impl JsonRow {
    /// Starts field `key`: the text its value follows.
    fn key(&mut self, key: &'static str) -> &mut String {
        assert!(self.keys.insert(key), "row key {key} written twice");
        self.text.push(if self.text.is_empty() { '{' } else { ',' });
        let _ = write!(self.text, "\"{key}\":");
        &mut self.text
    }

    fn field(&mut self, key: &'static str, value: Arguments) -> &mut Self {
        let _ = self.key(key).write_fmt(value);
        self
    }
{% if "int" in methods %}

    /// An integer, or null.
    pub(crate) fn int(&mut self, key: impl IntKey, v: impl Int) -> &mut Self {
        v.json(self.key(key.name()));
        self
    }
{% endif %}
{% if "num" in methods %}

    /// A number; JSON has no NaN or infinity, so those are null.
    pub(crate) fn num(&mut self, key: impl NumKey, v: f64) -> &mut Self {
        if v.is_finite() {
            self.field(key.name(), format_args!("{v}"))
        } else {
            self.field(key.name(), format_args!("null"))
        }
    }
{% endif %}
{% if "bool" in methods %}

    /// A boolean.
    pub(crate) fn bool(&mut self, key: impl BoolKey, v: bool) -> &mut Self {
        self.field(key.name(), format_args!("{v}"))
    }
{% endif %}
{% if "ints" in methods %}

    /// A list of integers.
    pub(crate) fn ints(&mut self, key: impl IntsKey, v: impl IntoIterator<Item = impl Int>) -> &mut Self {
        let out = self.key(key.name());
        out.push('[');
        for (i, x) in v.into_iter().enumerate() {
            if i > 0 {
                out.push(',');
            }
            x.json(out);
        }
        out.push(']');
        self
    }
{% endif %}
{% if "nums" in methods %}

    /// A list of numbers, to four places; null for NaN and infinity.
    pub(crate) fn nums(&mut self, key: impl NumsKey, v: impl IntoIterator<Item = f64>) -> &mut Self {
        let v: Vec<String> = v
            .into_iter()
            .map(|x| if x.is_finite() { format!("{x:.4}") } else { "null".to_owned() })
            .collect();
        self.field(key.name(), format_args!("[{}]", v.join(",")))
    }
{% endif %}
{% if "text" in methods %}

{% if text_check == "filter" %}
    /// A string, its quotes, backslashes and control characters left out
    /// (names and hashes).
    pub(crate) fn str(&mut self, key: impl TextKey, v: &str) -> &mut Self {
        let v: String = v
            .chars()
            .filter(|c| *c != '"' && *c != '\\' && !c.is_control())
            .collect();
        self.field(key.name(), format_args!("\"{v}\""))
    }
{% else %}
    /// A string without quotes, backslashes or control characters (names
    /// and tokens); one with any is the sim's mistake.
    pub(crate) fn str(&mut self, key: impl TextKey, v: &str) -> &mut Self {
        assert!(!v.contains(|c: char| c == '"' || c == '\\' || c.is_control()), "{v:?}");
        self.field(key.name(), format_args!("\"{v}\""))
    }
{% endif %}
{% endif %}
{% if "json" in methods %}

    /// Another JSON value, as `v` formats it.
    pub(crate) fn json(&mut self, key: impl JsonKey, v: Arguments) -> &mut Self {
        self.field(key.name(), v)
    }
{% endif %}

    /// The object's text.
    pub(crate) fn finish(&mut self) -> String {
        if self.text.is_empty() {
            self.text.push('{');
        }
        self.text.push('}');
        self.keys.clear();
        std::mem::take(&mut self.text)
    }
}

/// A column's type, as `hack/sim-db` names it.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub(crate) enum Ty {
    Int,
    Text,
    Bool,
}

impl Ty {
    /// Its name in a table's schema file.
    pub(crate) fn sql(self) -> &'static str {
        match self {
            Ty::Int => "BIGINT",
            Ty::Text => "VARCHAR",
            Ty::Bool => "BOOLEAN",
        }
    }
}

/// A table's column.
pub(crate) trait Column: Key {
    /// The table.
    const TABLE: &'static str;

    /// The column's type.
    fn ty(self) -> Ty;
}

