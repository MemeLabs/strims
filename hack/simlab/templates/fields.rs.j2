        fn ty(self) -> Ty {
            match self.0.ty {
                {{ b.path }}::ColumnType::Int => Ty::Int,
                {{ b.path }}::ColumnType::Text => Ty::Text,
                {{ b.path }}::ColumnType::Bool => Ty::Bool,
            }
