{{ header }}
//! The names {{ sim }} records, as `crates/strims-wan/fields.toml` declares
//! them: its row's fields and its `series_meta.json` keys by type
//! ({{ key_enums | map("code_link") | join(", ") }}), which [`JsonRow`] writes each as
//! its type, and each table's columns ([`cols`], each table's enum a
//! [`Column`]). A name the document doesn't give {{ sim }} has no variant
//! here, and a variant {{ sim }} never writes is dead code. A family (an id
//! with `{param}` parts) is a variant holding its name's place among the
//! family's names: its constructor takes the params' values and panics on
//! one the document doesn't give {{ sim }}; the values the code loops over
//! are the family's consts.

// The variants are the vocabulary's names, whatever they share.
#![allow(clippy::enum_variant_names)]

use std::collections::BTreeSet;
use std::fmt::{Arguments, Display, Write};

/// A recorded name: a row field, a `series_meta.json` key or a column.
pub(crate) trait Key: Copy + sealed::Sealed {
    /// The name, as {{ sim }} writes it.
    fn name(self) -> &'static str;
}

mod sealed {
    /// Only this module's names are [`Key`](super::Key)s, and only Rust's
    /// integers and their options are [`Int`](super::Int)s.
    pub trait Sealed {}
}

/// An integer [`JsonRow`] writes: one of Rust's integer types, or an
/// [`Option`] of one (null for `None`).
pub(crate) trait Int: sealed::Sealed {
    /// Appends the integer's JSON to `out`.
    fn json(&self, out: &mut String);
}
{% for t in int_types %}

impl sealed::Sealed for {{ t }} {}
impl Int for {{ t }} {
    fn json(&self, out: &mut String) {
        let _ = write!(out, "{self}");
    }
}
{% endfor %}

impl<T: Int> sealed::Sealed for Option<T> {}
impl<T: Int> Int for Option<T> {
    fn json(&self, out: &mut String) {
        match self {
            Some(v) => v.json(out),
            None => out.push_str("null"),
        }
    }
}
