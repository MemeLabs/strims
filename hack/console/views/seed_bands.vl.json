{
  "hover": {
    "x": "t"
  },
  "vconcat": [
    {
      "title": "Honest q0.9 lag across seeds",
      "width": "container",
      "height": 260,
      "hover": {
        "tooltip": [
          {
            "field": "t",
            "title": "s"
          },
          {
            "field": "seeds",
            "title": "runs"
          },
          {
            "field": "p10",
            "format": ",.0f"
          },
          {
            "field": "p25",
            "format": ",.0f"
          },
          {
            "field": "p50",
            "format": ",.0f"
          },
          {
            "field": "p75",
            "format": ",.0f"
          },
          {
            "field": "p90",
            "format": ",.0f"
          },
          {
            "field": "max",
            "format": ",.0f"
          },
          {
            "field": "worst_seed",
            "title": "worst seed"
          },
          {
            "field": "unhealthy_share",
            "title": "unhealthy",
            "format": ".0%"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "area"
          },
          "encoding": {
            "x": {
              "field": "t",
              "type": "quantitative",
              "title": null
            },
            "y": {
              "field": "p10",
              "type": "quantitative",
              "title": "lag (ms)",
              "scale": {
                "type": "symlog",
                "constant": 100
              }
            },
            "y2": {
              "field": "p90"
            },
            "color": {
              "datum": "p10–p90",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "p10–p90",
                  "p25–p75",
                  "p50",
                  "max"
                ],
                "range": [
                  "#cde2fb",
                  "#86b6ef",
                  "#184f95",
                  "#d03b3b"
                ]
              },
              "legend": {
                "encode": {
                  "symbols": {
                    "update": {
                      "shape": {
                        "signal": "datum.value === 'p50' || datum.value === 'max' ? 'stroke' : 'square'"
                      },
                      "strokeDash": {
                        "signal": "datum.value === 'max' ? [2, 2] : null"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "mark": {
            "type": "area"
          },
          "encoding": {
            "x": {
              "field": "t",
              "type": "quantitative",
              "title": null
            },
            "y": {
              "field": "p25",
              "type": "quantitative"
            },
            "y2": {
              "field": "p75"
            },
            "color": {
              "datum": "p25–p75",
              "type": "nominal"
            }
          }
        },
        {
          "mark": {
            "type": "line"
          },
          "encoding": {
            "x": {
              "field": "t",
              "type": "quantitative",
              "title": null
            },
            "y": {
              "field": "p50",
              "type": "quantitative"
            },
            "color": {
              "datum": "p50",
              "type": "nominal"
            }
          }
        },
        {
          "mark": {
            "type": "line",
            "strokeDash": [
              2,
              2
            ],
            "strokeWidth": 1.5
          },
          "encoding": {
            "x": {
              "field": "t",
              "type": "quantitative",
              "title": null
            },
            "y": {
              "field": "max",
              "type": "quantitative"
            },
            "color": {
              "datum": "max",
              "type": "nominal"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "d": 1250,
                "label": "1250 ms"
              },
              {
                "d": 4250,
                "label": "4250 ms"
              }
            ]
          },
          "mark": {
            "type": "rule",
            "strokeDash": [
              4,
              3
            ],
            "color": "#898781"
          },
          "encoding": {
            "y": {
              "field": "d",
              "type": "quantitative"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "d": 1250,
                "label": "1250 ms"
              },
              {
                "d": 4250,
                "label": "4250 ms"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 4,
            "dy": -6,
            "color": "#898781",
            "fontSize": 10
          },
          "encoding": {
            "y": {
              "field": "d",
              "type": "quantitative"
            },
            "x": {
              "value": 0
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    },
    {
      "title": "Share of seeds unhealthy",
      "width": "container",
      "height": 90,
      "hover": {
        "tooltip": [
          {
            "field": "t",
            "title": "s"
          },
          {
            "field": "unhealthy_share",
            "title": "unhealthy",
            "format": ".0%"
          },
          {
            "field": "seeds",
            "title": "runs"
          }
        ]
      },
      "mark": {
        "type": "area",
        "color": "#fab219",
        "interpolate": "step-after"
      },
      "encoding": {
        "x": {
          "field": "t",
          "type": "quantitative",
          "title": "seconds from the start, or from each run's event"
        },
        "y": {
          "field": "unhealthy_share",
          "type": "quantitative",
          "title": null,
          "axis": {
            "format": "%"
          },
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared"
    }
  },
  "config": {
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "labelLimit": 220,
      "titleLimit": 220,
      "columnPadding": 14
    },
    "axisY": {
      "labelLimit": 220
    }
  }
}
