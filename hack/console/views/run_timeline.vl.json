{
  "hover": {
    "x": "t_s"
  },
  "vconcat": [
    {
      "title": "Lag across viewers (playout delays dashed)",
      "width": "container",
      "height": 170,
      "hover": {
        "tooltip": [
          {
            "field": "t_s",
            "title": "s"
          },
          {
            "field": "p50",
            "format": ",.0f"
          },
          {
            "field": "p99",
            "format": ",.0f"
          },
          {
            "field": "max",
            "format": ",.0f"
          }
        ],
        "transform": [
          {
            "pivot": "series",
            "value": "value",
            "groupby": [
              "t_s"
            ]
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.track === 'lag'"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "line",
            "interpolate": "step-after"
          },
          "encoding": {
            "x": {
              "field": "t_s",
              "type": "quantitative",
              "title": null,
              "scale": {
                "zero": false
              }
            },
            "y": {
              "field": "value",
              "type": "quantitative",
              "title": "lag (ms)",
              "scale": {
                "type": "symlog",
                "constant": 100
              }
            },
            "color": {
              "field": "series",
              "type": "nominal",
              "title": "viewers' lag",
              "scale": {
                "domain": [
                  "p50",
                  "p99",
                  "max"
                ]
              }
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "d": 1250,
                "label": "1250 ms"
              },
              {
                "d": 4250,
                "label": "4250 ms"
              }
            ]
          },
          "mark": {
            "type": "rule",
            "strokeDash": [
              4,
              3
            ],
            "color": "#898781"
          },
          "encoding": {
            "y": {
              "field": "d",
              "type": "quantitative"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "d": 1250,
                "label": "1250 ms"
              },
              {
                "d": 4250,
                "label": "4250 ms"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 4,
            "dy": -6,
            "color": "#898781",
            "fontSize": 10
          },
          "encoding": {
            "y": {
              "field": "d",
              "type": "quantitative"
            },
            "x": {
              "value": 0
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    },
    {
      "title": "Each viewer's lag each second (log colour): a block at the left is startup, a stripe a spike",
      "width": "container",
      "height": 200,
      "hover": {},
      "transform": [
        {
          "filter": "datum.track === 'heat'"
        }
      ],
      "mark": {
        "type": "rect",
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "t_s",
          "type": "quantitative",
          "title": null,
          "scale": {
            "zero": false
          }
        },
        "x2": {
          "field": "t2_s"
        },
        "y": {
          "field": "viewer",
          "type": "ordinal",
          "title": "viewer",
          "axis": {
            "labelFontSize": 9,
            "labelOverlap": "parity"
          }
        },
        "color": {
          "field": "value",
          "type": "quantitative",
          "title": "lag (ms)",
          "scale": {
            "type": "log",
            "scheme": "blues",
            "domainMin": 50
          }
        },
        "tooltip": [
          {
            "field": "viewer"
          },
          {
            "field": "t_s",
            "title": "s"
          },
          {
            "field": "value",
            "title": "lag ms"
          }
        ]
      }
    },
    {
      "title": "Stalls at the playout delay picked, as long as picked or longer",
      "width": "container",
      "height": 140,
      "hover": {},
      "transform": [
        {
          "filter": "datum.track === 'stall'"
        }
      ],
      "mark": {
        "type": "rect",
        "color": "#d03b3b",
        "stroke": "#d03b3b",
        "strokeWidth": 1,
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "t_s",
          "type": "quantitative",
          "title": null,
          "scale": {
            "zero": false
          }
        },
        "x2": {
          "field": "t2_s"
        },
        "y": {
          "field": "viewer",
          "type": "ordinal",
          "title": "viewer",
          "axis": {
            "labelFontSize": 9,
            "labelOverlap": "parity"
          }
        },
        "tooltip": [
          {
            "field": "viewer"
          },
          {
            "field": "t_s",
            "title": "starts (s)",
            "format": ".2f"
          },
          {
            "field": "value",
            "title": "stall ms"
          }
        ]
      }
    },
    {
      "title": "Verdict: phases, unhealthy seconds, and the episodes",
      "width": "container",
      "height": 64,
      "hover": {},
      "transform": [
        {
          "filter": "datum.track === 'phase' || datum.track === 'episode'"
        }
      ],
      "mark": {
        "type": "rect",
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "t_s",
          "type": "quantitative",
          "title": null,
          "scale": {
            "zero": false
          }
        },
        "x2": {
          "field": "t2_s"
        },
        "y": {
          "field": "lane",
          "type": "nominal",
          "title": null,
          "sort": [
            "phase",
            "unhealthy s",
            "unhealthy spell",
            "collapse"
          ]
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "title": "verdict",
          "scale": {
            "domain": [
              "startup",
              "steady",
              "after_down",
              "after_up",
              "unhealthy",
              "collapse"
            ],
            "range": [
              "#cde2fb",
              "#e9e8e3",
              "#f2c7b3",
              "#c7e8d8",
              "#fab219",
              "#d03b3b"
            ]
          }
        },
        "tooltip": [
          {
            "field": "series"
          },
          {
            "field": "t_s",
            "title": "from (s)"
          },
          {
            "field": "t2_s",
            "title": "to (s)"
          },
          {
            "field": "detail",
            "title": "judged by"
          }
        ]
      }
    },
    {
      "title": "The seed's meter and its uplink",
      "width": "container",
      "height": 120,
      "hover": {
        "tooltip": [
          {
            "field": "t_s",
            "title": "s"
          },
          {
            "field": "capacity",
            "title": "meter reading",
            "format": ".2f"
          },
          {
            "field": "avail",
            "title": "uplink it had",
            "format": ".2f"
          }
        ],
        "transform": [
          {
            "pivot": "series",
            "value": "value",
            "groupby": [
              "t_s"
            ]
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.track === 'seed'"
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "step-after"
      },
      "encoding": {
        "x": {
          "field": "t_s",
          "type": "quantitative",
          "title": null,
          "scale": {
            "zero": false
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "Mbit/s"
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "title": "seed",
          "scale": {
            "domain": [
              "capacity",
              "avail"
            ],
            "range": [
              "#6250d6",
              "#1baf7a"
            ]
          },
          "legend": {
            "labelExpr": "datum.label === 'capacity' ? 'meter reading' : 'uplink it had'"
          }
        }
      }
    },
    {
      "title": "The seed's copies",
      "width": "container",
      "height": 70,
      "hover": {
        "tooltip": [
          {
            "field": "t_s",
            "title": "s"
          },
          {
            "field": "value",
            "title": "copies"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.track === 'copies'"
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "step-after",
        "color": "#eb6834"
      },
      "encoding": {
        "x": {
          "field": "t_s",
          "type": "quantitative",
          "title": null,
          "scale": {
            "zero": false
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "copies",
          "axis": {
            "tickMinStep": 1
          }
        }
      }
    },
    {
      "title": "Events (the verdict's in red)",
      "width": "container",
      "height": 160,
      "hover": {},
      "transform": [
        {
          "filter": "datum.track === 'event'"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "diamond",
        "size": 50,
        "filled": true,
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "t_s",
          "type": "quantitative",
          "title": null,
          "scale": {
            "zero": false
          }
        },
        "y": {
          "field": "series",
          "type": "nominal",
          "title": null,
          "axis": {
            "labelFontSize": 9
          }
        },
        "color": {
          "field": "source",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "sim",
              "verdict"
            ],
            "range": [
              "#2a78d6",
              "#d03b3b"
            ]
          }
        },
        "tooltip": [
          {
            "field": "series",
            "title": "kind"
          },
          {
            "field": "t_s",
            "title": "s",
            "format": ".3f"
          },
          {
            "field": "viewer",
            "title": "node"
          },
          {
            "field": "value"
          },
          {
            "field": "detail"
          }
        ]
      }
    },
    {
      "title": "Overhead the seed and the viewers wrote, by kind of message",
      "width": "container",
      "height": 150,
      "hover": {
        "tooltip": [
          {
            "field": "t_s",
            "title": "s"
          },
          {
            "field": "state",
            "format": ".1f",
            "filter": {
              "valid": true
            }
          },
          {
            "field": "integrity",
            "format": ".1f",
            "filter": {
              "valid": true
            }
          },
          {
            "field": "header",
            "format": ".1f",
            "filter": {
              "valid": true
            }
          },
          {
            "field": "ping",
            "format": ".1f",
            "filter": {
              "valid": true
            }
          },
          {
            "field": "request",
            "format": ".1f",
            "filter": {
              "valid": true
            }
          },
          {
            "field": "announce",
            "format": ".1f",
            "filter": {
              "valid": true
            }
          },
          {
            "field": "ack",
            "format": ".1f",
            "filter": {
              "valid": true
            }
          },
          {
            "field": "have",
            "format": ".1f",
            "filter": {
              "valid": true
            }
          }
        ],
        "transform": [
          {
            "pivot": "series",
            "value": "value",
            "groupby": [
              "t_s"
            ]
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.track === 'bytes'"
        }
      ],
      "mark": {
        "type": "area"
      },
      "encoding": {
        "x": {
          "field": "t_s",
          "type": "quantitative",
          "title": null,
          "scale": {
            "zero": false
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "kbit/s",
          "stack": true
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "title": "overhead written",
          "scale": {
            "domain": [
              "state",
              "integrity",
              "header",
              "ping",
              "request",
              "announce",
              "ack",
              "have"
            ]
          }
        }
      }
    },
    {
      "title": "Chunk data the seed and the viewers wrote",
      "width": "container",
      "height": 80,
      "hover": {
        "tooltip": [
          {
            "field": "t_s",
            "title": "s"
          },
          {
            "field": "value",
            "title": "data",
            "format": ",.0f"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.track === 'data'"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#2a78d6",
        "interpolate": "step-after"
      },
      "encoding": {
        "x": {
          "field": "t_s",
          "type": "quantitative",
          "title": null,
          "scale": {
            "zero": false
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "kbit/s"
        }
      }
    },
    {
      "title": "Packets their uplinks sent",
      "width": "container",
      "height": 80,
      "hover": {
        "tooltip": [
          {
            "field": "t_s",
            "title": "s"
          },
          {
            "field": "value",
            "title": "packets",
            "format": ",.0f"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.track === 'packets'"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#52514e",
        "interpolate": "step-after"
      },
      "encoding": {
        "x": {
          "field": "t_s",
          "type": "quantitative",
          "title": "seconds from the stream's start",
          "scale": {
            "zero": false
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "packets/s"
        }
      }
    }
  ],
  "transform": [
    {
      "calculate": "datum.track === 'episode' ? (datum.series === 'collapse' ? 'collapse' : 'unhealthy spell') : datum.series === 'unhealthy' ? 'unhealthy s' : 'phase'",
      "as": "lane"
    },
    {
      "calculate": "datum.detail === 'verdict' ? 'verdict' : 'sim'",
      "as": "source"
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared",
      "color": "independent"
    },
    "legend": {
      "color": "independent"
    }
  },
  "config": {
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "labelLimit": 200,
      "titleLimit": 200
    },
    "axisY": {
      "labelLimit": 120,
      "labelOverlap": "parity"
    }
  }
}
