{
  "hover": {
    "x": "t_s"
  },
  "vconcat": [
    {
      "title": "Lag across viewers (p99 solid, max dashed; playout delays grey)",
      "width": "container",
      "height": 220,
      "hover": {
        "tooltip": [
          {
            "field": "t_s",
            "title": "s"
          },
          {
            "field": "arms"
          },
          {
            "field": "p50"
          },
          {
            "field": "p99"
          },
          {
            "field": "max"
          }
        ],
        "transform": [
          {
            "filter": "datum.track === 'lag'"
          },
          {
            "window": [
              {
                "op": "first_value",
                "field": "arm",
                "as": "arm_a"
              },
              {
                "op": "last_value",
                "field": "arm",
                "as": "arm_b"
              }
            ],
            "sort": [
              {
                "field": "arm"
              }
            ],
            "frame": [
              null,
              null
            ]
          },
          {
            "calculate": "datum.series + (datum.arm === datum.arm_a ? '_a' : '_b')",
            "as": "key"
          },
          {
            "pivot": "key",
            "value": "value",
            "groupby": [
              "t_s",
              "arm_a",
              "arm_b"
            ]
          },
          {
            "calculate": "datum.arm_a === datum.arm_b ? datum.arm_a : datum.arm_a + ' · ' + datum.arm_b",
            "as": "arms"
          },
          {
            "calculate": "(isValid(datum.p50_a) ? format(datum.p50_a, ',.0f') : '–') + (datum.arm_a === datum.arm_b ? '' : ' · ' + (isValid(datum.p50_b) ? format(datum.p50_b, ',.0f') : '–'))",
            "as": "p50"
          },
          {
            "calculate": "(isValid(datum.p99_a) ? format(datum.p99_a, ',.0f') : '–') + (datum.arm_a === datum.arm_b ? '' : ' · ' + (isValid(datum.p99_b) ? format(datum.p99_b, ',.0f') : '–'))",
            "as": "p99"
          },
          {
            "calculate": "(isValid(datum.max_a) ? format(datum.max_a, ',.0f') : '–') + (datum.arm_a === datum.arm_b ? '' : ' · ' + (isValid(datum.max_b) ? format(datum.max_b, ',.0f') : '–'))",
            "as": "max"
          }
        ]
      },
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.track === 'lag' && datum.series !== 'p50'"
            }
          ],
          "mark": {
            "type": "line",
            "interpolate": "step-after"
          },
          "encoding": {
            "x": {
              "field": "t_s",
              "type": "quantitative",
              "title": null,
              "scale": {
                "zero": false
              }
            },
            "y": {
              "field": "value",
              "type": "quantitative",
              "title": "lag (ms)",
              "scale": {
                "type": "symlog",
                "constant": 100
              }
            },
            "color": {
              "field": "arm",
              "type": "nominal",
              "title": "arm"
            },
            "strokeDash": {
              "field": "series",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "p99",
                  "max"
                ],
                "range": [
                  [
                    1,
                    0
                  ],
                  [
                    4,
                    3
                  ]
                ]
              }
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "d": 1250,
                "label": "1250 ms"
              },
              {
                "d": 4250,
                "label": "4250 ms"
              }
            ]
          },
          "mark": {
            "type": "rule",
            "strokeDash": [
              4,
              3
            ],
            "color": "#898781"
          },
          "encoding": {
            "y": {
              "field": "d",
              "type": "quantitative"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "d": 1250,
                "label": "1250 ms"
              },
              {
                "d": 4250,
                "label": "4250 ms"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 4,
            "dy": -6,
            "color": "#898781",
            "fontSize": 10
          },
          "encoding": {
            "y": {
              "field": "d",
              "type": "quantitative"
            },
            "x": {
              "value": 0
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    },
    {
      "title": "Stalls per second at the playout delay",
      "width": "container",
      "height": 110,
      "hover": {},
      "transform": [
        {
          "filter": "datum.track === 'stalls'"
        }
      ],
      "mark": {
        "type": "bar",
        "tooltip": true,
        "opacity": 0.8
      },
      "encoding": {
        "x": {
          "field": "t_s",
          "type": "quantitative",
          "title": null,
          "scale": {
            "zero": false
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "stalls",
          "stack": null
        },
        "color": {
          "field": "arm",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "t_s",
            "title": "s"
          },
          {
            "field": "arm"
          },
          {
            "field": "value",
            "title": "stalls"
          }
        ]
      }
    },
    {
      "title": "Verdict: unhealthy seconds and collapses",
      "width": "container",
      "height": 70,
      "hover": {},
      "transform": [
        {
          "filter": "datum.track === 'verdict'"
        }
      ],
      "mark": {
        "type": "rect",
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "t_s",
          "type": "quantitative",
          "title": "seconds from the stream's start",
          "scale": {
            "zero": false
          }
        },
        "x2": {
          "field": "t2_s"
        },
        "y": {
          "field": "arm",
          "type": "nominal",
          "title": null
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "title": "verdict",
          "scale": {
            "vocab": "episodes",
            "only": [
              "unhealthy",
              "collapse"
            ]
          }
        },
        "opacity": {
          "value": 0.85
        },
        "yOffset": {
          "field": "series",
          "type": "nominal",
          "sort": {
            "vocab": "episodes",
            "only": [
              "unhealthy",
              "collapse"
            ]
          }
        },
        "tooltip": [
          {
            "field": "arm"
          },
          {
            "field": "series",
            "title": "verdict"
          },
          {
            "field": "t_s",
            "title": "from (s)"
          },
          {
            "field": "t2_s",
            "title": "to (s)"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared",
      "color": "independent"
    },
    "legend": {
      "color": "independent"
    }
  },
  "config": {
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "labelLimit": 220,
      "titleLimit": 220,
      "columnPadding": 14
    },
    "axisY": {
      "labelLimit": 220
    }
  }
}
