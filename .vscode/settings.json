{
  // prettier extension setting
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit"
    }
  },
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit"
    }
  },
  "[scss]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "files.associations": {
    "**/locales/*/*.json": "jsonc",
  },
  "prettier.configPath": ".prettierrc.json",
  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": true
    },
    "files.eol": "\n",
  },
  "go.testFlags": ["-count=1", "-v=1", "-mod=readonly"],
  "go.useLanguageServer": true,
  "go.vetOnSave": "package",
  "gopls": {
    "usePlaceholders": true,
    "staticcheck": false,
  },
  "go.languageServerExperimentalFeatures": {
    "diagnostics": true,
  },
  "protoc": {
    "path": "/usr/local/bin/protoc",
    "compile_on_save": true,
    "options": [
      "--proto_path=${workspaceRoot}/schema",
      // "--proto_path=${workspaceRoot}/vendor/prometheus_client_model",
      "--go_out=pkg/apis",
      "--go_opt=module=github.com/MemeLabs/strims/pkg/apis",
      "--gorpc_out=pkg/apis",
      "--gorpc_opt=module=github.com/MemeLabs/strims/pkg/apis",
      "--ts_out=src/apis",
      "--tsrpc_out=src/apis",
    ]
  },
  // TypeScript 7 (native) from node_modules via the TypeScript Native Preview extension
  "typescript.experimental.useTsgo": true,
  "typescript.native-preview.tsdk": "node_modules/typescript",
  "go.toolsEnvVars": {
    // "GOOS": "js",
    // "GOARCH": "wasm"
  },
}
