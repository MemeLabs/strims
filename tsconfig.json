{
  "compilerOptions": {
    // type checking only; webpack transpiles with swc and mocha with tsx
    "noEmit": true,
    // swc and tsx compile each file in isolation
    "isolatedModules": true,
    // other packages' declarations don't check: the dom and webworker libs,
    // emotion's, and those using the global JSX namespace React 19 dropped
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "module": "ESNext",
    "target": "es6",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "lib": ["dom", "es6", "es2020", "esnext.asynciterable", "webworker"],
    "types": ["node", "mocha", "webpack-env"],
    "paths": {
      // swiper 8's package.json exports have no types condition
      "swiper": ["./node_modules/swiper/swiper.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
  ],
  "exclude": ["dist", "node_modules"]
}
