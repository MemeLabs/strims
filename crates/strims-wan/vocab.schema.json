{
  "$defs": {
    "Entry": {
      "additionalProperties": false,
      "description": "A recorded name, or a family of them (an id with {param} parts).",
      "properties": {
        "sims": {
          "description": "The sims that write it; [] for a name only a line writes.",
          "items": {
            "enum": [
              "strims-sim",
              "ppspp"
            ],
            "type": "string"
          },
          "title": "Sims",
          "type": "array"
        },
        "lines": {
          "default": [],
          "description": "The lines that write it where main doesn't; a family's values a line adds are keyed by the line in its params.",
          "items": {
            "enum": [
              "decl",
              "p4tf"
            ],
            "type": "string"
          },
          "title": "Lines",
          "type": "array"
        },
        "writers": {
          "default": [],
          "description": "The lab's programs that add it to a sim's row, no sim writing it: suite (hack/simlab/suite.py's local runs). Its name starts with an underscore, which a sim's never does.",
          "items": {
            "const": "suite",
            "type": "string"
          },
          "title": "Writers",
          "type": "array"
        },
        "retired": {
          "default": [],
          "description": "The sims whose older runs hold it, which no sim writes now: a retired name, kept so their rows and tables still read.",
          "items": {
            "enum": [
              "strims-sim",
              "ppspp"
            ],
            "type": "string"
          },
          "title": "Retired",
          "type": "array"
        },
        "replaced_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "propertyNames": {
                "enum": [
                  "strims-sim",
                  "ppspp"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A retired name's replacement, the name of its section that took its place: one, or a table by sim; none where no name took it.",
          "title": "Replaced By"
        },
        "rename": {
          "default": false,
          "description": "A rows field's replacement means the same: the catalog's rows view reads its values as the replacement's, for the sims it is retired for (replaced_by's).",
          "title": "Rename",
          "type": "boolean"
        },
        "type": {
          "description": "int, num, text, bool, ints (a list of integers), nums (a list of numbers), json (another JSON value).",
          "enum": [
            "int",
            "num",
            "text",
            "bool",
            "ints",
            "nums",
            "json"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "none": {
          "anyOf": [
            {
              "enum": [
                "empty",
                "-1",
                "0",
                "negative",
                "null"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How a sim writes none: an empty field, -1, 0, a negative time (before the start), or JSON's null.",
          "title": "None"
        },
        "older_none": {
          "anyOf": [
            {
              "const": "-1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How older runs wrote none, which the catalog's view reads as none too.",
          "title": "Older None"
        },
        "params": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "items": {
                      "pattern": "^[a-z0-9_]*$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "additionalProperties": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "type": "object"
                  }
                ]
              },
              "type": "object"
            },
            {
              "items": {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "items": {
                        "pattern": "^[a-z0-9_]*$",
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "additionalProperties": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "type": "object"
                    }
                  ]
                },
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A family's params: {param = values}, each a list, or a table of lists by sim (and line); a list of such tables is their union.",
          "title": "Params"
        },
        "code": {
          "additionalProperties": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object"
          },
          "default": {},
          "description": "By sim, a param's values as the code's arrays (Rust expressions, concatenated): a generated test holds them equal.",
          "propertyNames": {
            "enum": [
              "strims-sim",
              "ppspp"
            ]
          },
          "title": "Code",
          "type": "object"
        },
        "consts": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "default": {},
          "description": "By sim, the params whose values the code loops over as the generated module's consts.",
          "propertyNames": {
            "enum": [
              "strims-sim",
              "ppspp"
            ]
          },
          "title": "Consts",
          "type": "object"
        },
        "description": {
          "description": "What it holds: what it counts or measures, over whom and when.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "notes": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "A sim's own doc where it says more, or other.",
          "propertyNames": {
            "enum": [
              "strims-sim",
              "ppspp"
            ]
          },
          "title": "Notes",
          "type": "object"
        }
      },
      "required": [
        "sims",
        "type",
        "description"
      ],
      "title": "Entry",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "properties": {
        "sims": {
          "items": {
            "enum": [
              "strims-sim",
              "ppspp"
            ],
            "type": "string"
          },
          "title": "Sims",
          "type": "array"
        },
        "lines": {
          "default": [],
          "items": {
            "enum": [
              "decl",
              "p4tf"
            ],
            "type": "string"
          },
          "title": "Lines",
          "type": "array"
        },
        "grain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grain"
        },
        "keys": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keys"
        },
        "joins": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Joins"
        },
        "knobs": {
          "default": [],
          "description": "The settings that write it, without their sim's prefix (STRIMS_SIM_ or SIM_).",
          "items": {
            "type": "string"
          },
          "title": "Knobs",
          "type": "array"
        },
        "sample": {
          "default": false,
          "description": "A sample table (store_host.SAMPLE_TABLES): the farm uploads it apart.",
          "title": "Sample",
          "type": "boolean"
        },
        "zstd": {
          "default": false,
          "description": "Written zstd-compressed, <table>.csv.zst.",
          "title": "Zstd",
          "type": "boolean"
        },
        "normalized": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the catalog's view changes.",
          "title": "Normalized"
        },
        "none": {
          "anyOf": [
            {
              "const": "-1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Every numeric column but the ids writes none as -1, declared or not: the view reads -1 as none in each.",
          "title": "None"
        },
        "shared": {
          "anyOf": [
            {
              "const": "seed_log",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its columns are a shared formatter's, which both sims write through.",
          "title": "Shared"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "notes": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "propertyNames": {
            "enum": [
              "strims-sim",
              "ppspp"
            ]
          },
          "title": "Notes",
          "type": "object"
        }
      },
      "required": [
        "sims"
      ],
      "title": "Table",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "rows": {
      "additionalProperties": {
        "$ref": "#/$defs/Entry"
      },
      "title": "Rows",
      "type": "object"
    },
    "meta": {
      "additionalProperties": {
        "$ref": "#/$defs/Entry"
      },
      "title": "Meta",
      "type": "object"
    },
    "tables": {
      "additionalProperties": {
        "$ref": "#/$defs/Table"
      },
      "title": "Tables",
      "type": "object"
    },
    "columns": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/Entry"
        },
        "type": "object"
      },
      "title": "Columns",
      "type": "object"
    }
  },
  "required": [
    "rows",
    "meta",
    "tables",
    "columns"
  ],
  "title": "crates/strims-wan/fields.toml",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
